# Copy to `.env` for local development. On Azure App Service, add the same
# variable NAMES under Configuration → Application settings (use Key Vault
# references for production secrets).

# --- Django core ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.azurewebsites.net
CSRF_TRUSTED_ORIGINS=https://your-app.azurewebsites.net,http://localhost,http://127.0.0.1
CORS_ORIGIN_ALLOW_ALL=True

# --- Google Sign-In ---
GOOGLE_OAUTH_CLIENT_ID=

# --- Firebase Admin (service account JSON as a single Base64 line) ---
FIREBASE_CREDENTIALS=
# Alias:
# FIREBASE_CREDENTIALS_BASE64=

# --- Azure Blob Storage ---
# Either set the full connection string from the portal, OR name + key:
AZURE_STORAGE_CONNECTION_STRING=
AZURE_ACCOUNT_NAME=
AZURE_ACCOUNT_KEY=
AZURE_CONTAINER_NAME=braelo
AZURE_CUSTOM_DOMAIN=

# --- Redis (Channels) ---
REDIS_URL=redis://127.0.0.1:6379/0

# --- Twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# --- SMTP ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# --- JWT (optional) ---
JWT_BLACKLIST_AFTER_ROTATION=True
JWT_ACCESS_TOKEN_MINUTES=2880
JWT_SLIDING_REFRESH_DAYS=7
JWT_SLIDING_TOKEN_DAYS=30
JWT_SLIDING_REFRESH_LATE_DAYS=1
JWT_SLIDING_TOKEN_LATE_DAYS=30

# --- FCM (push) ---
FCM_SERVER_KEY=

# --- MongoDB ---
# Primary: full URI (Azure often uses CUSTOMCONNSTR_MONGO_URI or MONGO_URI)
MONGO_URI=
MONGO_DB_NAME=braelo
# Alternative build (requires all three):
MONGO_USERNAME=
MONGO_PASSWORD=
MONGO_ATLAS_HOST=

DJANGO_SKIP_MONGOENGINE=
# CI uses MONGO_URI or skips; see settings.py

# --- Chatbot / RAG (optional) ---
OPENAI_API_KEY=
GPT_MODEL=gpt-4o-mini
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_RADIUS_M=6000
GOOGLE_PLACES_MAX_RESULTS=7
EMBEDDING_MODEL=text-embedding-3-small
KNOWLEDGE_SIMILARITY_THRESHOLD=0.55
RAG_TOP_K=8
RAG_HYBRID_EMBEDDING_WEIGHT=0.58
RAG_SIMILARITY_THRESHOLD=0.32
RAG_SIMILARITY_FALLBACK=0.20
RAG_QUERY_REWRITE=true
RAG_STRONG_MATCH_HYBRID=0.68
RAG_MIN_CONFIDENT_HYBRID=0.46
RAG_EMBEDDING_MIN_FOR_MATCH=0.18
DOCX_DATA_DIR=
MAX_BUSINESS_RESULTS=5
BUSINESS_RADIUS_MILES=25
BUSINESS_RADIUS_FALLBACK_MILES=50
MIN_BUSINESS_RESULTS=3
MONGO_BUSINESS_COLLECTIONS=business_listings,businesses
KB_PROVIDER_SUGGESTIONS=true
KB_PROVIDER_SUGGESTIONS_MAX=3
USE_MONGO=false
BRAELO_MONGO_URI=
